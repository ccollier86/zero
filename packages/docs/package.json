{
  "name": "@zero/plugin-docs",
  "version": "0.1.0",
  "description": "Optional tokenized Markdown documentation sites for Zero.",
  "type": "module",
  "engines": { "bun": ">=1.3.14" },
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./src/index.ts" },
    "./content": { "types": "./src/content/index.ts", "import": "./src/content/index.ts" },
    "./react": { "types": "./src/ui/index.ts", "import": "./src/ui/index.ts" },
    "./styles.css": "./src/ui/docs.css"
  },
  "files": ["src", "README.md", "THIRD_PARTY_NOTICES.md", "!src/**/*.test.*", "!src/**/*.fixture.*", "!src/**/*-fixture.ts", "!src/**/*-fixture.tsx"],
  "peerDependencies": {
    "@zero/framework": ">=2.5.0 <3",
    "react": ">=19.2.0 <20",
    "react-dom": ">=19.2.0 <20"
  },
  "dependencies": {
    "github-slugger": "2.0.0",
    "ignore": "7.0.12",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  }
}
