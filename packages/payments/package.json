{
  "name": "@zero/plugin-payments",
  "version": "0.2.0",
  "description": "Optional Stripe and Square payments, billing and verified webhooks through one Zero facade.",
  "type": "module",
  "engines": { "bun": ">=1.3.14" },
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./src/index.ts" },
    "./client": { "types": "./src/client/index.ts", "import": "./src/client/index.ts" },
    "./square": { "types": "./src/square/index.ts", "import": "./src/square/index.ts" }
  },
  "files": ["src", "README.md", "THIRD_PARTY_NOTICES.md", "!src/**/*.test.*", "!src/**/*-fixture.*"],
  "peerDependencies": { "@zero/framework": ">=2.6.0 <3" },
  "peerDependenciesMeta": { "@zero/framework": { "optional": true } },
  "dependencies": { "stripe": "23.0.1", "square": "46.0.0" },
  "devDependencies": { "@types/node": "25.3.3" }
}
