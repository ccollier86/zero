  "scripts": {
    "test": "bun test",
    "dev": "bun --watch src/cli/run.ts",
    "build": "bun build src/frontend/index.ts src/frontend/server.ts src/cli/run.ts src/create-zero/run.ts --target bun --outdir dist",
    "build:binary": "bun build --compile src/cli/run.ts --outfile zero",
    "typecheck": "tsc --noEmit",
    "test:package": "bun test --timeout 120000 src/create-zero/scaffold.test.ts src/update/bun-lock-integrity.test.ts src/update/run.test.ts src/package-exports.test.ts src/native-package-recipes.test.ts src/package-distribution.test.ts src/build-scripts.test.ts",
    "doctor": "bun run src/doctor/run.ts",
    "migrate": "bun run src/migrations/run.ts",
    "migrate:status": "bun run src/migrations/run.ts --status",
    "migrate:doctor": "bun run src/migrations/run.ts --doctor",
    "migrate:plan": "bun run src/migrations/run.ts --plan",
    "pdf:install": "bun run src/cli/run.ts pdf install",
    "pdf:status": "bun run src/cli/run.ts pdf status",
    "create-zero": "bun run src/create-zero/run.ts",
    "zero": "bun run src/cli/run.ts",
    "install:local-tools": "bash scripts/install-local-tools.sh",
    "version:bump": "bun run scripts/bump-version.ts"
  },
