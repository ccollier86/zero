# Zero app runtime
PORT=3000
DB_PATH=./data/app.db
APP_NAME="Zero App"
APP_PUBLIC_URL=http://localhost:3000
APP_SUPPORT_EMAIL=support@example.com

# Auth token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
AUTH_ACTION_TOKEN_TTL=1h
AUTH_ACCOUNT_EMAIL_COOLDOWN=5m
AUTH_MANUAL_PASSWORD_RESET=true

# Generic zero.tokens action/resume tokens do not require env vars.
# Set their TTL/cooldown per call in app-owned server code.

# Optional managed signing key.
# Leave blank to let Zero generate and store an ES256 keypair in the app DB.
AUTH_SIGNING_KEY=

# System email for auth/account lifecycle.
# Resend is the default provider when email is enabled.
EMAIL_FROM="Zero App <noreply@example.com>"
EMAIL_REPLY_TO=support@example.com
RESEND_API_KEY=

# Optional AI providers.
# Set ai: true in createApp() to auto-enable providers with keys present here.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
COHERE_API_KEY=
LLAMA_API_KEY=
META_LLAMA_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=
PERPLEXITYAI_API_KEY=
VOYAGE_API_KEY=
DEEPGRAM_API_KEY=

# Optional explicit non-catalog provider convention.
# Example: ai.providers.local can inherit LOCAL_API_KEY when apiKey is omitted.
LOCAL_API_KEY=

# Optional AI base URL overrides.
# Leave blank for normal provider defaults. Use only for proxies, local gateways,
# self-hosted-compatible endpoints, or provider endpoint overrides.
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
GOOGLE_BASE_URL=
GROQ_BASE_URL=
XAI_BASE_URL=
COHERE_BASE_URL=
META_BASE_URL=
META_LLAMA_BASE_URL=
DEEPSEEK_BASE_URL=
PERPLEXITY_BASE_URL=
VOYAGE_BASE_URL=
DEEPGRAM_BASE_URL=

# Example: ai.providers.local can inherit LOCAL_BASE_URL when baseURL is omitted.
LOCAL_BASE_URL=

# Optional AI alias overrides.
ZERO_AI_FAST_MODEL=
ZERO_AI_SMART_MODEL=
ZERO_AI_EMBEDDING_MODEL=
ZERO_AI_IMAGE_MODEL=
ZERO_AI_TRANSCRIPTION_MODEL=
ZERO_AI_SPEECH_MODEL=

# Optional local vector storage.
# Set vector config in createApp(); ZERO_VECTOR_ENABLED is a starter-app
# convention you can use to toggle that config.
ZERO_VECTOR_ENABLED=false
ZERO_VECTOR_DATA_DIR=./data/vector
ZERO_VECTOR_DEFAULT_DIMENSIONS=1536
