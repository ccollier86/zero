# Zero app runtime
PORT=3000
# Hot SQLite is the default: active data runs in memory and snapshots recover
# restarts. Set DB_MODE=file for direct SQLite/WAL mode, or ephemeral for tests.
DB_MODE=hot
DB_PATH=./data/app.db
DB_SNAPSHOT_PATH=./data/app.snapshot.db
# Zero/Guardian authority always uses a separate system database. This root
# example relies on Zero's durable ./data/zero.system.db default. Apps exposing
# overrides should map them to `systemDb` in zero.config.ts.
# SYSTEM_DB_MODE=file
# SYSTEM_DB_PATH=./data/zero.system.db
# SYSTEM_DB_SNAPSHOT_PATH=
APP_NAME="Zero App"
APP_PUBLIC_URL=http://localhost:3000
APP_LOGO_URL=
APP_SUPPORT_EMAIL=support@example.com

# Auth token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Required only while creating the first administrator. Generate at least 32
# random characters, keep it in deployment secrets, and remove/rotate it after
# setup. Example generator: openssl rand -base64 32
AUTH_BOOTSTRAP_SECRET=
AUTH_ACTION_TOKEN_TTL=1h
AUTH_ACCOUNT_EMAIL_COOLDOWN=5m
AUTH_MANUAL_PASSWORD_RESET=true

# Auth verification/MFA settings. Email verification, MFA setup, and MFA
# challenge routes are active when enabled.
AUTH_EMAIL_BRAND_COLOR=
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_EMAIL_VERIFICATION_PATH=/verify-email
AUTH_MFA_ENABLED=true
AUTH_MFA_POLICY=optional
AUTH_MFA_METHODS=email,totp
# Authenticator/TOTP is self-hosted by Zero. No external TOTP provider is used.
# This secret encrypts authenticator seeds at rest when TOTP is enabled.
AUTH_TOTP_ENCRYPTION_KEY=
# Multi-tenant invitation email uses an external 32-byte base64url KEK. Generate
# with the command documented in docs/auth/tenant-invitations-and-join-requests.md.
# During rotation only, set the comma-separated prior key list for one complete
# rollout, then remove it after all instances use the new active key.
AUTH_TENANT_INVITATION_ENCRYPTION_KEY=
AUTH_TENANT_INVITATION_PREVIOUS_ENCRYPTION_KEYS=

# Generic zero.tokens action/resume tokens do not require env vars.
# Set their TTL/cooldown per call in app-owned server code.

# Platform KV/cache. Omit to use durable everysec journal/checkpoint recovery
# under ./data/kv from createApp() defaults.
ZERO_KV_BASE_DIR=./data/kv
ZERO_KV_DURABILITY=everysec

# Optional managed ES256 private JWK (raw JSON or base64; not PEM).
# Missing kid is derived deterministically, so replicas may share the same JWK.
# Leave blank to let Zero generate and store an ES256 keypair in the system DB.
AUTH_SIGNING_KEY=

# Optional HMAC key shared by storage presigned URLs and upload grants.
# Leave blank with a durable shared system database and Zero generates/persists
# a random 32-byte key there. Set at least 32 random bytes for ephemeral system
# databases or replicas that do not share it. Example: openssl rand -base64 32
ZERO_STORAGE_SIGNING_SECRET=

# System email for auth/account lifecycle.
# Resend is the default provider when email is enabled.
EMAIL_FROM="Zero App <noreply@example.com>"
EMAIL_REPLY_TO=support@example.com
RESEND_API_KEY=

# Optional AI providers.
# Set ai: true in createApp() to auto-enable providers with keys present here.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
COHERE_API_KEY=
LLAMA_API_KEY=
META_LLAMA_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=
PERPLEXITYAI_API_KEY=
VOYAGE_API_KEY=
DEEPGRAM_API_KEY=

# Optional explicit non-catalog provider convention.
# Example: ai.providers.local can inherit LOCAL_API_KEY when apiKey is omitted.
LOCAL_API_KEY=

# Optional AI base URL overrides.
# Leave blank for normal provider defaults. Use only for proxies, local gateways,
# self-hosted-compatible endpoints, or provider endpoint overrides.
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
GOOGLE_BASE_URL=
GROQ_BASE_URL=
XAI_BASE_URL=
COHERE_BASE_URL=
META_BASE_URL=
META_LLAMA_BASE_URL=
DEEPSEEK_BASE_URL=
PERPLEXITY_BASE_URL=
VOYAGE_BASE_URL=
DEEPGRAM_BASE_URL=

# Example: ai.providers.local can inherit LOCAL_BASE_URL when baseURL is omitted.
LOCAL_BASE_URL=

# Optional AI alias overrides.
ZERO_AI_FAST_MODEL=
ZERO_AI_SMART_MODEL=
ZERO_AI_EMBEDDING_MODEL=
ZERO_AI_IMAGE_MODEL=
ZERO_AI_TRANSCRIPTION_MODEL=
ZERO_AI_SPEECH_MODEL=

# Optional local vector storage.
# Set vector config in createApp(); ZERO_VECTOR_ENABLED is a starter-app
# convention you can use to toggle that config.
ZERO_VECTOR_ENABLED=false
ZERO_VECTOR_DATA_DIR=./data/vector
ZERO_VECTOR_DEFAULT_DIMENSIONS=1536

# Optional browser-grade HTML/CSS-to-PDF rendering. Generated apps use the
# enabled flag as a zero.config.ts convention. Run `bun run pdf:install` once
# per development machine or production image before rendering.
ZERO_PDF_ENABLED=false
# Optional system-managed Chromium override. Leave blank for Zero's managed
# Playwright browser.
ZERO_PDF_EXECUTABLE_PATH=
