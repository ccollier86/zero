PORT=3210
APP_PUBLIC_URL=http://localhost:3210

# Generate a local value with: openssl rand -base64 32
AUTH_BOOTSTRAP_SECRET=replace-with-a-random-secret-at-least-32-characters

# The control plane is deliberately separate from tenant application data.
ZERO_CONTROL_DB_PATH=./data/control.sqlite
ZERO_TENANT_DATABASE_ROOT=./data/tenants

# Comma-separated tenant IDs copied from the app header. Omit for all-file mode.
ZERO_HOT_TENANT_IDS=

# Hard logical SQLite image ceiling for every allowlisted hot tenant.
ZERO_HOT_MAX_BYTES=67108864
