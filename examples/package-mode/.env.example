APP_NAME=Zero App
APP_PUBLIC_URL=http://localhost:3000
APP_SUPPORT_EMAIL=support@example.com
PORT=3000
# Application data. Leave paths blank to use the defaults in zero.config.ts.
DB_MODE=hot
DB_PATH=
DB_SNAPSHOT_PATH=

# Zero-owned state (Guardian identity/sessions/RBAC and other platform state).
# Keep this durable and on a different SQLite path from the application DB.
SYSTEM_DB_MODE=file
SYSTEM_DB_PATH=./data/zero.system.db
SYSTEM_DB_SNAPSHOT_PATH=

# Email. The generated starter enables email only when RESEND_API_KEY is set.
RESEND_API_KEY=
EMAIL_FROM="Zero App <noreply@example.com>"
EMAIL_REPLY_TO=support@example.com
AUTH_EMAIL_BRAND_COLOR=

# Auth stays disabled until this switch is true. Before enabling it, generate
# a one-time operator setup secret with `openssl rand -base64 32`, store it as
# a deployment secret, then enter it on the first-administrator screen.
ZERO_AUTH_ENABLED=false
AUTH_BOOTSTRAP_SECRET=
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_EMAIL_VERIFICATION_PATH=/verify-email
AUTH_ACTION_TOKEN_TTL=1h
AUTH_ACCOUNT_EMAIL_COOLDOWN=5m
AUTH_MANUAL_PASSWORD_RESET=true
AUTH_MFA_ENABLED=false
AUTH_MFA_POLICY=optional
AUTH_MFA_METHODS=email,totp
# Authenticator/TOTP is self-hosted by Zero. No external TOTP provider is used.
# This secret encrypts authenticator seeds at rest when TOTP is enabled.
AUTH_TOTP_ENCRYPTION_KEY=

# Optional shared HMAC key for storage presigned URLs/upload grants. Durable
# databases can leave this blank and use Zero's persisted generated key.
ZERO_STORAGE_SIGNING_SECRET=

# Platform KV/cache
ZERO_KV_BASE_DIR=./data/kv
ZERO_KV_DURABILITY=everysec

# AI providers are auto-detected when complete credentials are present. See
# node_modules/@zero/framework/docs/ai-providers.md for capabilities, cloud
# credentials, precedence, aliases, and endpoint rules.
# Complete env credential/endpoint shapes are detected automatically. This can
# force the plugin on/off, but does not invent credentials or opt in to OIDC.
# Gateway OIDC is trusted code: configure
# providers.gateway = { type: 'gateway', apiKey: null } in zero.config.ts.
ZERO_AI_ENABLED=
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
AZURE_API_KEY=
AZURE_RESOURCE_NAME=
AZURE_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
# Claude Platform on AWS always needs a workspace. API-key mode additionally
# needs a region or endpoint; SigV4 mode always needs a region.
ANTHROPIC_AWS_API_KEY=
ANTHROPIC_AWS_WORKSPACE_ID=
ANTHROPIC_AWS_BASE_URL=
AWS_REGION=
AWS_DEFAULT_REGION=
AWS_BEARER_TOKEN_BEDROCK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_BASE_URL=
AMAZON_BEDROCK_BASE_URL=
AWS_ENDPOINT_URL_BEDROCK_RUNTIME=
AWS_ENDPOINT_URL_BEDROCK_AGENT_RUNTIME=
AWS_ENDPOINT_URL=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_VERTEX_API_KEY=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=
GROQ_API_KEY=
XAI_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
TOGETHER_AI_API_KEY=
DEEPINFRA_API_KEY=
DEEPSEEK_API_KEY=
CEREBRAS_API_KEY=
PERPLEXITY_API_KEY=
PERPLEXITYAI_API_KEY=
FIREWORKS_API_KEY=
VOYAGE_API_KEY=
FAL_API_KEY=
FAL_KEY=
LUMA_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
HUME_API_KEY=
REVAI_API_KEY=
ASSEMBLYAI_API_KEY=
GLADIA_API_KEY=
FISH_AUDIO_API_KEY=
REPLICATE_API_TOKEN=
PRODIA_TOKEN=
BFL_API_KEY=
ARK_API_KEY=
KLINGAI_API_KEY=
# Legacy Kling authentication requires both values and is ignored when the API
# key above is present.
KLINGAI_ACCESS_KEY=
KLINGAI_SECRET_KEY=
CARTESIA_API_KEY=
GMI_CLOUD_APIKEY=
QUIVERAI_API_KEY=
BASETEN_API_KEY=
HUGGINGFACE_API_KEY=
MOONSHOT_API_KEY=
ALIBABA_API_KEY=
MINIMAX_API_KEY=
ZAI_API_KEY=
TOPAZ_API_KEY=
OPEN_RESPONSES_BASE_URL=

# Optional friendly-model alias overrides (`providerId/modelId`).
ZERO_AI_FAST_MODEL=
ZERO_AI_SMART_MODEL=
ZERO_AI_EMBEDDING_MODEL=
ZERO_AI_IMAGE_MODEL=
ZERO_AI_TRANSCRIPTION_MODEL=
ZERO_AI_SPEECH_MODEL=
ZERO_AI_RERANKING_MODEL=
ZERO_AI_VIDEO_MODEL=
# Optional default provider id for hosted-file operations.
ZERO_AI_FILES_PROVIDER=
# Optional app-owned HMAC secret passed explicitly to AI tool/agent approval
# configuration. Zero does not read this variable implicitly; use at least 32
# bytes of high-entropy server-only material.
ZERO_AI_APPROVAL_SECRET=

# Vector store
ZERO_VECTOR_ENABLED=false
ZERO_VECTOR_DATA_DIR=./data/vector
ZERO_VECTOR_DEFAULT_DIMENSIONS=1536

# PDF rendering. Enable, then run `bun run pdf:install` once for this machine
# or deploy image. Set the executable path only for system-managed Chromium.
ZERO_PDF_ENABLED=false
ZERO_PDF_EXECUTABLE_PATH=
