APP_NAME=Zero App
APP_PUBLIC_URL=http://localhost:3000
APP_SUPPORT_EMAIL=support@example.com
PORT=3000
# Optional file-mode override. Leave blank to use hot SQLite with snapshot
# recovery from zero.config.ts defaults.
DB_MODE=hot
DB_PATH=
DB_SNAPSHOT_PATH=

# Email. The generated starter enables email only when RESEND_API_KEY is set.
RESEND_API_KEY=
EMAIL_FROM="Zero App <noreply@example.com>"
EMAIL_REPLY_TO=support@example.com
AUTH_EMAIL_BRAND_COLOR=

# Auth stays disabled until this switch is true. Before enabling it, generate
# a one-time operator setup secret with `openssl rand -base64 32`, store it as
# a deployment secret, then enter it on the first-administrator screen.
ZERO_AUTH_ENABLED=false
AUTH_BOOTSTRAP_SECRET=
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_EMAIL_VERIFICATION_PATH=/verify-email
AUTH_ACTION_TOKEN_TTL=1h
AUTH_ACCOUNT_EMAIL_COOLDOWN=5m
AUTH_MANUAL_PASSWORD_RESET=true
AUTH_MFA_ENABLED=false
AUTH_MFA_POLICY=optional
AUTH_MFA_METHODS=email,totp
# Authenticator/TOTP is self-hosted by Zero. No external TOTP provider is used.
# This secret encrypts authenticator seeds at rest when TOTP is enabled.
AUTH_TOTP_ENCRYPTION_KEY=

# Optional shared HMAC key for storage presigned URLs/upload grants. Durable
# databases can leave this blank and use Zero's persisted generated key.
ZERO_STORAGE_SIGNING_SECRET=

# Platform KV/cache
ZERO_KV_BASE_DIR=./data/kv
ZERO_KV_DURABILITY=everysec

# AI providers are auto-detected when keys are present.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
COHERE_API_KEY=
LLAMA_API_KEY=
META_LLAMA_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=
VOYAGE_API_KEY=
DEEPGRAM_API_KEY=

# Vector store
ZERO_VECTOR_ENABLED=false
ZERO_VECTOR_DATA_DIR=./data/vector
ZERO_VECTOR_DEFAULT_DIMENSIONS=1536

# PDF rendering. Enable, then run `bun run pdf:install` once for this machine
# or deploy image. Set the executable path only for system-managed Chromium.
ZERO_PDF_ENABLED=false
ZERO_PDF_EXECUTABLE_PATH=
